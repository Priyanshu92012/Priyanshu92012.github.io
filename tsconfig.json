{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "worker/src/**/*", "scripts/**/*"],
  "exclude": ["dist", "prototypes", "public"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@cloudflare/workers-types"],
    "noUncheckedIndexedAccess": false
  }
}
