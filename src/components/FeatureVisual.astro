---
// Small deterministic diagrams previewing each case-study demo. Pure SVG,
// drawn on scroll by GSAP (data-draw); fully visible without JS.
import type { DemoKind } from '../data/index';
interface Props { kind: DemoKind }
const { kind } = Astro.props;
const lanes = Array.from({ length: 6 }, (_, i) => i);
const bars: [number, number, number, string][] = [
  [0, 10, 70, 'active'], [0, 92, 40, 'reserved'], [1, 30, 110, 'active'], [2, 6, 36, 'failed'], [2, 50, 60, 'reserved'],
  [3, 20, 50, 'releasing'], [3, 80, 70, 'active'], [4, 4, 90, 'reserved'], [4, 104, 40, 'active'], [5, 40, 100, 'active'],
];
const tokens = [['Revenue', 0.12], ['beat', 0.58], ['forecasts', 0.21], ['despite', -0.18], ['weak', -0.47], ['guidance', -0.09]] as const;
---
<svg class={`fv fv-${kind}`} viewBox="0 0 240 150" aria-hidden="true" focusable="false">
  {kind === 'scheduler' && (
    <g>
      {lanes.map((l) => <line class="ln" x1="0" x2="240" y1={14 + l * 22} y2={14 + l * 22} />)}
      {bars.map(([l, x, w, s]) => <rect class={`bar s-${s}`} x={x + 8} y={6 + l * 22} width={w} height="14" rx="2" data-draw />)}
      <line class="now" x1="128" x2="128" y1="0" y2="140" />
    </g>
  )}
  {kind === 'gmre' && (
    <g>
      <rect class="box" x="10" y="10" width="120" height="128" rx="4" data-draw />
      <rect class="box" x="22" y="30" width="96" height="98" rx="4" data-draw />
      <rect class="box" x="34" y="50" width="72" height="68" rx="4" data-draw />
      <rect class="box hot" x="46" y="70" width="48" height="38" rx="4" data-draw />
      <text x="16" y="24">.tgz</text><text x="28" y="44">.tar</text><text x="40" y="64">.zip</text><text x="52" y="84">.log</text>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <circle class={`stage ${i < 5 ? 'done' : ''}`} cx={150 + (i % 2) * 40} cy={18 + i * 18} r="5" />)}
      <path class="flow" d="M150 18 L190 36 L150 54 L190 72 L150 90 L190 108 L150 126" data-draw />
    </g>
  )}
  {kind === 'xai' && (
    <g>
      <line class="ln" x1="0" x2="240" y1="80" y2="80" />
      {tokens.map(([t, v], i) => (
        <g>
          <rect class={v >= 0 ? 'pos' : 'neg'} x={8 + i * 39} y={v >= 0 ? 80 - v * 90 : 80} width="26" height={Math.abs(v) * 90} rx="2" data-draw />
          <text x={21 + i * 39} y="142" text-anchor="middle">{t}</text>
        </g>
      ))}
    </g>
  )}
  {kind === 'securemed' && (
    <g>
      <path class="flow" d="M10 75 H230" data-draw />
      {['lint', 'test', 'sast', 'deps', 'secrets', 'deploy'].map((g, i) => (
        <g>
          <rect class={`gate ${i === 3 ? 'blocked' : i < 3 ? 'pass' : 'idle'}`} x={10 + i * 38} y="58" width="32" height="34" rx="4" data-draw />
          <text x={26 + i * 38} y="112" text-anchor="middle">{g}</text>
        </g>
      ))}
      <text class="warn" x="124" y="44" text-anchor="middle">CVE found → release blocked</text>
    </g>
  )}
  {kind === 'basyx' && (
    <g>
      <text x="10" y="14">.aasx package</text><text x="140" y="14">repository</text>
      {[0, 1, 2, 3, 4].map((i) => <rect class={`row ${i === 2 ? 'conflict' : ''}`} x="10" y={22 + i * 24} width="90" height="16" rx="2" data-draw />)}
      {[0, 1, 2, 3].map((i) => <rect class="row" x="140" y={22 + i * 24} width="90" height="16" rx="2" data-draw />)}
      {[0, 1, 2].map((i) => <path class={`link ${i === 2 ? 'conflict' : ''}`} d={`M100 ${30 + i * 24} C120 ${30 + i * 24}, 120 ${30 + i * 24}, 140 ${30 + i * 24}`} data-draw />)}
    </g>
  )}
  {kind === 'arena' && (
    <g>
      <text x="10" y="16">agent A</text><text x="10" y="86">agent B</text>
      {[0, 1, 2, 3, 4].map((i) => <rect class="slot" x={70 + i * 33} y="6" width="26" height="22" rx="3" />)}
      {[0, 1, 2, 3, 4].map((i) => <rect class="slot" x={70 + i * 33} y="76" width="26" height="22" rx="3" />)}
      <text class="warn" x="120" y="138" text-anchor="middle">awaiting approved runs</text>
    </g>
  )}
  {kind === 'guide' && (
    <g>
      <rect class="row" x="10" y="16" width="120" height="22" rx="11" data-draw />
      <text class="fv-t" x="22" y="31">who is he?</text>
      {['normalise', 'guards', 'intent', 'answer'].map((t, i) => (
        <g>
          <rect class={`stage${i === 3 ? ' done' : ''}`} x={10 + i * 56} y="62" width="48" height="24" rx="5" data-draw />
          <text class="fv-t fv-t-s" x={34 + i * 56} y="77" text-anchor="middle">{t}</text>
          {i < 3 && <path class="flow" d={`M${58 + i * 56} 74h8`} data-draw />}
        </g>
      ))}
      <rect class="box hot" x="110" y="104" width="120" height="30" rx="10" data-draw />
      <text class="fv-t" x="122" y="123">curated answer · 2 links</text>
    </g>
  )}
  {kind === 'opticlab' && (
    <g>
      {['U-Boot', 'Linux', 'verity', 'driver', 'daemon'].map((t, i) => (
        <g>
          <rect class={`stage${i === 4 ? ' done' : ''}`} x={8 + i * 46} y="30" width="40" height="24" rx="5" data-draw />
          <text class="fv-t fv-t-s" x={28 + i * 46} y="45" text-anchor="middle">{t}</text>
          {i < 4 && <path class="flow" d={`M${48 + i * 46} 42h6`} data-draw />}
        </g>
      ))}
      <text class="fv-t fv-t-s" x="8" y="18">signed FIT · RSA-2048 / SHA-256</text>
      {[0, 1, 2, 3].map((i) => <rect class={`box${i === 2 ? ' hot' : ''}`} x={40 + i * 42} y="84" width="34" height="46" rx="4" data-draw />)}
      <text class="fv-t fv-t-s" x="8" y="144">OLC-4 · slot 3 fault → degraded</text>
    </g>
  )}
  {kind === 'xray' && (
    <g>
      <rect class="box" x="10" y="10" width="220" height="130" rx="6" data-draw />
      <rect class="box hot" x="24" y="24" width="90" height="60" rx="4" data-draw />
      <rect class="box" x="124" y="24" width="92" height="30" rx="4" data-draw />
      <rect class="box" x="124" y="62" width="92" height="64" rx="4" data-draw />
    </g>
  )}
</svg>

<style>
  .fv { width: 100%; height: auto; overflow: visible; }
  .fv text { font: 500 8px var(--font-mono); fill: var(--fg-mute); letter-spacing: 0.04em; }
  .fv .ln { stroke: var(--line); stroke-width: 1; }
  .fv .now { stroke: var(--accent); stroke-dasharray: 2 3; }
  .fv .bar { fill: color-mix(in srgb, var(--violet) 35%, transparent); stroke: var(--violet); }
  .fv .bar.s-active { fill: color-mix(in srgb, var(--bio) 30%, transparent); stroke: var(--bio); }
  .fv .bar.s-releasing { fill: none; stroke: var(--orange); stroke-dasharray: 3 2; }
  .fv .bar.s-failed { fill: color-mix(in srgb, var(--orange) 30%, transparent); stroke: var(--orange); }
  .fv .box { fill: none; stroke: var(--line-strong); }
  .fv .box.hot { stroke: var(--accent); fill: color-mix(in srgb, var(--accent) 10%, transparent); }
  .fv .stage { fill: var(--surface-2); stroke: var(--line-strong); }
  .fv .stage.done { fill: var(--accent); stroke: none; }
  .fv .flow { fill: none; stroke: var(--line-strong); stroke-width: 1.2; }
  .fv .pos { fill: color-mix(in srgb, var(--bio) 55%, transparent); }
  .fv .neg { fill: color-mix(in srgb, var(--orange) 55%, transparent); }
  .fv .gate { fill: var(--surface-2); stroke: var(--line-strong); }
  .fv .gate.pass { stroke: var(--bio); }
  .fv .gate.blocked { stroke: var(--orange); fill: color-mix(in srgb, var(--orange) 22%, transparent); }
  .fv .warn { fill: var(--orange); }
  .fv .row { fill: var(--surface-2); stroke: var(--line-strong); }
  .fv .row.conflict, .fv .link.conflict { stroke: var(--orange); }
  .fv .link { fill: none; stroke: var(--violet); }
  .fv .slot { fill: none; stroke: var(--line-strong); stroke-dasharray: 3 3; }
  .fv .fv-t { fill: var(--fg-soft); font: 500 9px var(--font-mono); }
  .fv .fv-t-s { font-size: 7.5px; }
  .fv .stage.done + .fv-t { fill: var(--on-accent); }
</style>
