---
import { profile } from '../data/index';
import { localeFromPath, localizePath, isLocalized, OG_LOCALE } from '../i18n/index';
interface Props { title: string; description: string; image?: string; noindex?: boolean; type?: 'website' | 'article' }
const { title, description, image = '/og.png', noindex: noindexProp = false, type = 'website' } = Astro.props;
// Staging builds (PUBLIC_STAGING=1) must never be indexed.
const noindex = noindexProp || import.meta.env.PUBLIC_STAGING === '1';
const site = Astro.site ?? new URL('https://priyanshu92012.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const lang = localeFromPath(Astro.url.pathname);
const alternates = isLocalized(Astro.url.pathname) ? (['en', 'de'] as const).map((l) => ({ l, href: new URL(localizePath(Astro.url.pathname, l), site).href })) : [];
const imageUrl = new URL(image, site).href;
const fullTitle = title === profile.brand ? `${profile.brand} · ${profile.name}, ${profile.role}` : `${title} · ${profile.brand}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  knowsLanguage: ['hi', 'de', 'en'],
  address: { '@type': 'PostalAddress', addressLocality: 'Stuttgart', addressCountry: 'DE' },
  worksFor: { '@type': 'Organization', name: 'Nokia' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'DHBW Stuttgart' },
  url: site.href,
  sameAs: [profile.links.github, profile.links.linkedin],
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
<meta property="og:locale" content={OG_LOCALE[lang]} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.brand} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
